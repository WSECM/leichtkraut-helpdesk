# Vorlage. Echte Werte NIE in dieses Repository.
# Auf dem Server liegt die echte Datei unter server/.env (Rechte 600).

PORT=5181
APP_URL=https://tool.example.de
# Kennung des Arbeitsbereichs in der Oberflaeche (Teil der URL)
APP_WORKSPACE=workspace

# ── Postfach (IMAP eingehend, SMTP ausgehend) ───────────────────────────────
IMAP_HOST=imap.ionos.com
IMAP_EMAIL=support@example.de
IMAP_PASSWORD=
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SEND_AS=support@example.de

# ── KI (Anthropic) ──────────────────────────────────────────────────────────
# Entwuerfe laufen auf einem starken Modell, Pruefer und Uebersetzung auf einem
# guenstigen. Die Modellnamen stehen in server/data/connections.json.
ANTHROPIC_API_KEY=

# ── Interner Token fuer Wartungsskripte und Cronjobs ────────────────────────
# Beliebige lange Zufallszeichenkette, z. B. openssl rand -hex 32
SERVICE_TOKEN=

# ── Optionale Anbindungen ───────────────────────────────────────────────────
DHL_API_KEY=
DHL_API_SECRET=
PARCELSAPP_API_KEY=
SHOPIFY_REDIRECT=
HETZNER_API_TOKEN=
IONOS_API_KEY=
